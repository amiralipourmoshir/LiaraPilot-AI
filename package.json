{
  "name": "liarapilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --env-file=.env apps/api/src/server.ts",
    "dev:worker": "tsx watch --env-file=.env apps/worker/src/main.ts",
    "dev:web": "pnpm --filter @liarapilot/web dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit && pnpm --filter @liarapilot/web typecheck",
    "build": "pnpm db:generate && pnpm typecheck && pnpm --filter @liarapilot/web build && tsup apps/api/src/server.ts apps/worker/src/main.ts --format esm --out-dir dist --sourcemap --no-splitting",
    "start:api": "node --env-file=.env dist/api/src/server.js",
    "start:worker": "node --env-file=.env dist/worker/src/main.js",
    "test": "vitest run",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "test:prepare": "tsx scripts/prepare-tests.ts",
    "infra:local": "tsx --env-file=.env scripts/local-infra.ts",
    "test:ui": "vitest run apps/web/src/tests tests/demo.test.ts",
    "secrets:init": "tsx scripts/init-credential-key.ts",
    "liara:types": "openapi-typescript docs/references/paas.yaml -o packages/liara-adapter/src/generated.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sparticuz/chromium": "^153.0.0",
    "acorn": "^8.19.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.71.0",
    "diff": "^9.0.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.8.0",
    "ipaddr.js": "^2.5.0",
    "pino": "^10.0.0",
    "playwright": "1.64.1",
    "tar-stream": "^3.2.2",
    "ws": "^8.22.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/tar-stream": "^3.1.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
