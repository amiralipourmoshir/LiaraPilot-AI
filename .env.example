NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://liarapilot:liarapilot_local@127.0.0.1:55432/liarapilot?schema=public
REDIS_URL=redis://127.0.0.1:56379
SESSION_TTL_HOURS=168
LOG_LEVEL=info
# Generate a local key with pnpm secrets:init. Do not commit or rotate it without a credential migration.
# CREDENTIAL_KEY=<32 random bytes, base64>
CREDENTIAL_KEY_VERSION=v1
LIARA_TIMEOUT_MS=10000

# Optional server-only model configuration. Never prefix secrets with VITE_.
# AI_API_KEY=<provider key>
# AI_MODEL=<model ID supported by your provider and selected API style>
AI_BASE_URL=https://api.openai.com/v1
AI_API_STYLE=responses
AI_TIMEOUT_MS=30000

# Comma-separated server allowlist for the model picker; never accepts arbitrary browser model IDs.
# AI_MODELS=openai/gpt-6.1-sol,openai/gpt-6-luna,openai/gpt-6-astra

# GitHub OAuth App (server only; callback: APP_ORIGIN/api/v1/github/callback)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
