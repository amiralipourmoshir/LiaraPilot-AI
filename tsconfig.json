{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/api/src",
    "apps/worker/src",
    "packages",
    "tests",
    "prisma.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/*.ts"
  ]
}
